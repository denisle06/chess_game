<UserControl x:Class="ChessUI.UpgradeMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChessUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="275"
            Height="400"
            Style="{StaticResource BorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       x:Name="UpgradeText"
                       Text="Choose An Upgrade"
                       Style="{StaticResource TextStyle}"
                       FontSize="28"/>
            <Border Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="1" Background="Gray" />
            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Width="1"
                    HorizontalAlignment="Right"
                    Background="Gray"/>
            
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       x:Name="FirstUpgradeText"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Margin="16"
                       Text="Upgrade Detail"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" 
                       Style="{StaticResource TextStyle}"
                       FontSize="20"/>
            
            <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="16"
                   x:Name="SecondUpgradeText"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Text="Upgrade Detail"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="Center"
                   MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" 
                   Style="{StaticResource TextStyle}"
                   FontSize="20"/>

            <Border Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="1" Background="Gray" />
            

                <Button Grid.Row="2"
                    Content="Choose"
                    Style="{StaticResource ButtonStyle}"
                    Width="80"
                    Height="30"
                    Click="Choose_Upgrade_1"/>

            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="Choose"
                    Style="{StaticResource ButtonStyle}"
                    Width="80"
                    Height="30"
                    Click="Choose_Upgrade_2"/>
        </Grid>

    </Border>
</UserControl>
